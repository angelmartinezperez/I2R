{
    "name": "Pyflink Devcontainer",

    "build": {
        "dockerfile": "Dockerfile",
        "context": "..",
        "options": ["--tag=i2r_devcontainer"]
    },

    "runArgs": [
        "--name=i2r_devcontainer",
        "--network=i2r-network",
        "--volume=/var/run/docker.sock:/var/run/docker.sock",
        "--volume=i2r_paimon:/tmp/paimon"
    ],

    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
    },

    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
}